# .env.example
# Variáveis de ambiente para diferentes profiles
# Copie este arquivo para .env e preencha com suas variáveis reais

# ========================================
# DESENVOLVIMENTO LOCAL (profile: local)
# ========================================
# Descomente as linhas abaixo se for executar localmente
# sem Docker Compose

# DB_HOST=localhost
# DB_PORT=5434
# DB_NAME=obramanager
# DB_USER=postgres
# DB_PASS=postgres
# JWT_SECRET=dev-local-secret-key-only-for-testing-12345
# FILE_UPLOAD_DIR=./uploads

# ========================================
# QA / HOMOLOGAÇÃO (profile: qa)
# ========================================
# Use variáveis de ambiente do seu servidor de QA

# DB_HOST=seu-servidor-qa.com
# DB_PORT=5432
# DB_NAME=obramanager_qa
# DB_USER=sua-user-qa
# DB_PASS=sua-senha-qa
# JWT_SECRET=seu-jwt-secret-qa
# FILE_UPLOAD_DIR=/var/uploads

# ========================================
# PRODUÇÃO (profile: prod)
# ========================================
# Use variáveis de ambiente do seu servidor de produção
# NO RENDER.COM: Configure via Dashboard > Environment

# DB_HOST=seu-servidor-prod.com
# DB_PORT=5432
# DB_NAME=obramanager_prod
# DB_USER=sua-user-prod
# DB_PASS=sua-senha-prod  (GERAR AUTOMATICAMENTE NO RENDER)
# JWT_SECRET=seu-jwt-secret-prod  (GERAR AUTOMATICAMENTE NO RENDER)
# FILE_UPLOAD_DIR=/var/uploads

# ========================================
# EMAIL (Opcional)
# ========================================
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=seu-email@gmail.com
# MAIL_PASS=sua-senha-app
